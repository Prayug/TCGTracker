NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./tcg-prices.db

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Comma-separated for multiple origins in production
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
LOG_FILE=./backend.log

# Optional API keys — never commit real values
POKEMON_TCG_API_KEY=
TCGCSV_API_KEY=
APIFY_API_TOKEN=

# Optional eBay Browse API (client-credentials) for live PSA 10 BIN asks.
# Without these, slab marks stay sold-comps + last-sold date from PriceCharting.
# Create an app at https://developer.ebay.com/ and use the production client id/secret.
# Production keysets stay disabled until you configure Marketplace account deletion
# notifications (or apply for an exemption) on the Application Keys page.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=production
# EBAY_VERIFICATION_TOKEN=
# EBAY_NOTIFICATION_ENDPOINT=https://your-public-host/api/ebay/marketplace-account-deletion

# Email alerts (optional — leave blank to disable)
# Gmail: use an App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tcgtracker.com
APP_URL=http://localhost:5173

# eBay deal watcher: emails new Pokémon / One Piece listings priced well under market.
# Runs inside the backend when eBay + SMTP are configured. Defaults shown.
# DEAL_WATCH_ENABLED=true
# DEAL_ALERT_EMAIL=            # defaults to SMTP_USER
# DEAL_WATCH_INTERVAL_MIN=15
# DEAL_WATCH_GAMES=pokemon,onepiece
# DEAL_WATCH_NEW_SET_DAYS=90   # Pokémon sets released this recently count as new
# DEAL_ALERT_MIN_DISCOUNT=25   # % under market
# DEAL_ALERT_MIN_SAVINGS=15    # $ under market
# DEAL_ALERT_NEW_SET_MIN_DISCOUNT=15
# DEAL_ALERT_NEW_SET_MIN_SAVINGS=10
# DEAL_ALERT_MIN_MARKET=20
# DEAL_ALERT_MAX_PRICE=        # optional cap on all-in cost

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

ADMIN_USERNAME=admin

CLOUD_SYNC_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=tcgtracker-data
