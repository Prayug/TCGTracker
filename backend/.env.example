NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./tcg-prices.db

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Comma-separated for multiple origins in production
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
LOG_FILE=./backend.log

# Optional API keys — never commit real values
POKEMON_TCG_API_KEY=
TCGCSV_API_KEY=
APIFY_API_TOKEN=

# Optional eBay Browse API (client-credentials) for live PSA 10 BIN asks.
# Without these, slab marks stay sold-comps + last-sold date from PriceCharting.
# Create an app at https://developer.ebay.com/ and use the production client id/secret.
# Production keysets stay disabled until you configure Marketplace account deletion
# notifications (or apply for an exemption) on the Application Keys page.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=production
# EBAY_VERIFICATION_TOKEN=
# EBAY_NOTIFICATION_ENDPOINT=https://your-public-host/api/ebay/marketplace-account-deletion

# Email alerts (optional — leave blank to disable)
# Gmail: use an App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tcgtracker.com
APP_URL=http://localhost:5173

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

ADMIN_USERNAME=admin

CLOUD_SYNC_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=tcgtracker-data
